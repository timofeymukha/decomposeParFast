From a44162acdd000807609911aa24f41541a04b9285 Mon Sep 17 00:00:00 2001
From: Timofey Mukha <timofey.mukha@fau.de>
Date: Thu, 5 Nov 2026 16:12:55 +0100
Subject: [PATCH] ENH: decomposePar: remove O(nProcs*meshSize) work and
 collated read-back

Three per-processor costs made decomposePar scale with
nProcs * meshSize (or quadratically in nProcs):

- writeDecomposition() allocated and filled full-mesh pointLookup and
  faceLookup lists for every processor. They are now allocated once
  (with the zone markers) and only the touched entries are reset after
  each processor.

- decomposeMesh() allocated a bitSet(nPoints) per processor and used
  sortedToc(), which scans the whole set. The bitSet is now allocated
  once, the used points are collected while marking and then sorted.

- The field decomposition read every processor mesh and its addressing
  back from disk. For collated files, reading block i skips blocks
  0..i-1 by reading them (istream::ignore), so the cost of processor i
  grows with i. The processor fvMesh and addressing are now rebuilt in
  memory with the same code that writes them (buildProcMesh). The
  option -readProcMeshes restores the previous behaviour; the read-back
  is also kept for -fields and for meshes whose points come from a
  different instance.

The written decomposition is unchanged (byte-identical output).

Example (46.4M cells, 3072 domains, collated, Int64):
decomposePar 1:53:21 -> 0:02:56.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../decomposePar/decomposePar.cxx             |   83 ++
 .../decomposePar/domainDecomposition.H        |   73 ++
 .../decomposePar/domainDecomposition.cxx      | 1095 +++++++++--------
 .../decomposePar/domainDecompositionMesh.cxx  |   20 +-
 4 files changed, 773 insertions(+), 498 deletions(-)

diff --git a/applications/utilities/parallelProcessing/decomposePar/decomposePar.cxx b/applications/utilities/parallelProcessing/decomposePar/decomposePar.cxx
index 864d0b20..f6d6e7c3 100644
--- a/applications/utilities/parallelProcessing/decomposePar/decomposePar.cxx
+++ b/applications/utilities/parallelProcessing/decomposePar/decomposePar.cxx
@@ -412,6 +412,12 @@ int main(int argc, char *argv[])
         true  // Advanced option
     );
 
+    argList::addBoolOption
+    (
+        "readProcMeshes",
+        "Read processor meshes back from disk for field decomposition"
+        " (original behaviour)"
+    );
     argList::addBoolOption
     (
         "cellDist",
@@ -916,6 +922,19 @@ int main(int argc, char *argv[])
             PtrList<labelIOList> pointBoundaryProcAddressingList(numProcs);
 
             PtrList<fvFieldDecomposer> fieldDecomposerList(numProcs);
+
+            // Rebuild processor meshes in memory instead of reading back
+            const bool inMemoryProcMeshes =
+            (
+                !decomposeFieldsOnly
+             && !args.found("readProcMeshes")
+             && mesh.canBuildProcMeshes()
+            );
+            if (inMemoryProcMeshes)
+            {
+                Info<< "Field decomposition uses in-memory processor meshes"
+                    << nl;
+            }
             PtrList<pointFieldDecomposer> pointFieldDecomposerList(numProcs);
 
 
@@ -1267,6 +1286,70 @@ int main(int argc, char *argv[])
                         emplaceTime(processorDbList, proci, args);
                     processorDb.setTime(runTime);
 
+                    // Processor mesh and addressing: rebuild in memory from
+                    // the decomposition when available. Reading them back
+                    // costs O(proci) per file for collated (block skipping).
+                    if (inMemoryProcMeshes && !procMeshList.test(proci))
+                    {
+                        procMeshList.set
+                        (
+                            proci,
+                            mesh.processorFvMesh(proci, processorDb)
+                        );
+
+                        const auto& pm = procMeshList[proci];
+                        auto setAddr =
+                        [&](PtrList<labelIOList>& lst, const word& name,
+                            const labelUList& addr)
+                        {
+                            lst.resize(numProcs);
+                            lst.set
+                            (
+                                proci,
+                                new labelIOList
+                                (
+                                    IOobject
+                                    (
+                                        name,
+                                        pm.facesInstance(),
+                                        polyMesh::meshSubDir,
+                                        pm,
+                                        IOobjectOption::NO_READ,
+                                        IOobjectOption::NO_WRITE,
+                                        IOobjectOption::NO_REGISTER
+                                    ),
+                                    addr
+                                )
+                            );
+                        };
+                        setAddr
+                        (
+                            faceProcAddressingList, "faceProcAddressing",
+                            mesh.procFaceAddressing(proci)
+                        );
+                        setAddr
+                        (
+                            cellProcAddressingList, "cellProcAddressing",
+                            mesh.procCellAddressing(proci)
+                        );
+                        setAddr
+                        (
+                            boundaryProcAddressingList,
+                            "boundaryProcAddressing",
+                            mesh.procBoundaryAddressing(proci)
+                        );
+                        if (!pointFieldCache.empty())
+                        {
+                            // (cleared again after the point fields)
+                            setAddr
+                            (
+                                pointProcAddressingList,
+                                "pointProcAddressing",
+                                mesh.procPointAddressing(proci)
+                            );
+                        }
+                    }
+
                     // Read the mesh
                     const auto& procMesh = procMeshList.try_emplace
                     (
diff --git a/applications/utilities/parallelProcessing/decomposePar/domainDecomposition.H b/applications/utilities/parallelProcessing/decomposePar/domainDecomposition.H
index 7a80c9dd..e176febc 100644
--- a/applications/utilities/parallelProcessing/decomposePar/domainDecomposition.H
+++ b/applications/utilities/parallelProcessing/decomposePar/domainDecomposition.H
@@ -120,6 +120,22 @@ class domainDecomposition
         List<labelListList> procProcessorPatchSubPatchStarts_;
 
 
+        // Work data for constructing processor meshes
+
+        //- Lookups/zone markers prepared
+        mutable bool procMeshBuildReady_ = false;
+
+        //- Full-mesh point/face to processor-local index (-1 if unused).
+        //  Allocated once, only touched entries are reset per processor.
+        mutable labelList pointLookup_;
+        mutable labelList faceLookup_;
+
+        //- Single zone per point/face/cell (-1: none, -2: multiple)
+        mutable labelList pointToZone_;
+        mutable labelList faceToZone_;
+        mutable labelList cellToZone_;
+
+
     // Private Member Functions
 
         void distributeCells();
@@ -156,6 +172,21 @@ class domainDecomposition
             BinaryOp bop
         ) const;
 
+        //- Prepare lookups and zone markers (once)
+        void initProcMeshBuild() const;
+
+        //- Reset the lookup entries touched by processor proci
+        void resetProcMeshBuild(const label proci) const;
+
+        //- Construct processor mesh (points, faces, cells, patches, zones).
+        //  Leaves the lookups set for proci; call resetProcMeshBuild after.
+        template<class MeshType>
+        autoPtr<MeshType> buildProcMesh
+        (
+            const label proci,
+            const Time& processorDb
+        ) const;
+
 
 public:
 
@@ -232,6 +263,48 @@ public:
         //- Write decomposition
         bool writeDecomposition(const bool decomposeSets);
 
+        //- True if the processor meshes can be rebuilt in memory
+        //- (decomposition done, mesh points not from a different instance)
+        bool canBuildProcMeshes() const noexcept
+        {
+            return
+            (
+                !facesInstancePointsPtr_
+             && procCellAddressing_.size() == nProcs_
+             && procPatchSize_.size() == nProcs_
+             && (nProcs_ == 0 || procPatchSize_[0].size())
+            );
+        }
+
+        //- In-memory processor fvMesh, identical to the one written by
+        //- writeDecomposition (avoids reading it back from disk)
+        autoPtr<fvMesh> processorFvMesh
+        (
+            const label proci,
+            const Time& processorDb
+        ) const;
+
+        //- Point addressing (processor to complete mesh) for proci
+        const labelList& procPointAddressing(const label proci) const
+        {
+            return procPointAddressing_[proci];
+        }
+
+        //- Face addressing (with turning index) for proci
+        const labelUList& procFaceAddressing(const label proci) const
+        {
+            return procFaceAddressing_[proci];
+        }
+
+        //- Cell addressing for proci
+        const labelList& procCellAddressing(const label proci) const
+        {
+            return procCellAddressing_[proci];
+        }
+
+        //- Boundary addressing for proci (identity, -1 for processor patches)
+        labelList procBoundaryAddressing(const label proci) const;
+
 
     // Write
 
diff --git a/applications/utilities/parallelProcessing/decomposePar/domainDecomposition.cxx b/applications/utilities/parallelProcessing/decomposePar/domainDecomposition.cxx
index 7d5e36cc..0bae69e7 100644
--- a/applications/utilities/parallelProcessing/decomposePar/domainDecomposition.cxx
+++ b/applications/utilities/parallelProcessing/decomposePar/domainDecomposition.cxx
@@ -49,6 +49,7 @@ License
 #include "meshPointPatch.H"
 #include "processorPointPatch.H"
 #include "DynamicField.H"
+#include <type_traits>
 
 // * * * * * * * * * * * * * Private Member Functions  * * * * * * * * * * * //
 
@@ -148,9 +149,21 @@ void Foam::domainDecomposition::updateParameters
 }
 
 
-bool Foam::domainDecomposition::writeDecomposition(const bool decomposeSets)
+// * * * * * * * * * * * * Processor mesh construction  * * * * * * * * * * //
+
+void Foam::domainDecomposition::initProcMeshBuild() const
 {
-    Info<< "\nConstructing processor meshes" << endl;
+    if (procMeshBuildReady_)
+    {
+        return;
+    }
+
+    // Full-mesh-size inverse lookups, allocated once and reset after each
+    // processor (only the touched entries): avoids O(nProcs*(nPoints+nFaces))
+    pointLookup_.resize_nocopy(nPoints());
+    pointLookup_ = -1;
+    faceLookup_.resize_nocopy(nFaces());
+    faceLookup_ = -1;
 
     // Mark point/faces/cells that are in zones.
     // -1   : not in zone
@@ -161,30 +174,595 @@ bool Foam::domainDecomposition::writeDecomposition(const bool decomposeSets)
     // for the duplicate elements
 
     // Point zones
-    labelList pointToZone(points().size(), -1);
+    pointToZone_.resize_nocopy(points().size());
+    pointToZone_ = -1;
 
     forAll(pointZones(), zonei)
     {
-        mark(pointZones()[zonei], zonei, pointToZone);
+        mark(pointZones()[zonei], zonei, pointToZone_);
     }
 
     // Face zones
-    labelList faceToZone(faces().size(), -1);
+    faceToZone_.resize_nocopy(faces().size());
+    faceToZone_ = -1;
 
     forAll(faceZones(), zonei)
     {
-        mark(faceZones()[zonei], zonei, faceToZone);
+        mark(faceZones()[zonei], zonei, faceToZone_);
     }
 
     // Cell zones
-    labelList cellToZone(nCells(), -1);
+    cellToZone_.resize_nocopy(nCells());
+    cellToZone_ = -1;
 
     forAll(cellZones(), zonei)
     {
-        mark(cellZones()[zonei], zonei, cellToZone);
+        mark(cellZones()[zonei], zonei, cellToZone_);
     }
 
 
+    procMeshBuildReady_ = true;
+}
+
+
+void Foam::domainDecomposition::resetProcMeshBuild(const label proci) const
+{
+    UIndirectList<label>(pointLookup_, procPointAddressing_[proci]) = -1;
+    for (const label facei : procFaceAddressing_[proci])
+    {
+        faceLookup_[mag(facei) - 1] = -1;
+    }
+}
+
+
+template<class MeshType>
+Foam::autoPtr<MeshType> Foam::domainDecomposition::buildProcMesh
+(
+    const label proci,
+    const Time& processorDb
+) const
+{
+    initProcMeshBuild();
+
+    // Create processor points
+    const labelList& curPointLabels = procPointAddressing_[proci];
+
+    pointField procPoints(points(), curPointLabels);
+
+    forAll(curPointLabels, pointi)
+    {
+        pointLookup_[curPointLabels[pointi]] = pointi;
+    }
+
+    // Create processor faces
+    const labelList& curFaceLabels = procFaceAddressing_[proci];
+
+    const faceList& meshFaces = faces();
+
+    faceList procFaces(curFaceLabels.size());
+
+    forAll(curFaceLabels, facei)
+    {
+        // Mark the original face as used
+        // Remember to decrement the index by one (turning index)
+        label curF = mag(curFaceLabels[facei]) - 1;
+
+        faceLookup_[curF] = facei;
+
+        // get the original face
+        labelList origFaceLabels;
+
+        if (curFaceLabels[facei] >= 0)
+        {
+            // face not turned
+            origFaceLabels = meshFaces[curF];
+        }
+        else
+        {
+            origFaceLabels = meshFaces[curF].reverseFace();
+        }
+
+        // translate face labels into local point list
+        face& procFaceLabels = procFaces[facei];
+
+        procFaceLabels.setSize(origFaceLabels.size());
+
+        forAll(origFaceLabels, pointi)
+        {
+            procFaceLabels[pointi] = pointLookup_[origFaceLabels[pointi]];
+        }
+    }
+
+    // Create processor cells
+    const labelList& curCellLabels = procCellAddressing_[proci];
+
+    const cellList& meshCells = cells();
+
+    cellList procCells(curCellLabels.size());
+
+    forAll(curCellLabels, celli)
+    {
+        const labelList& origCellLabels = meshCells[curCellLabels[celli]];
+
+        cell& curCell = procCells[celli];
+
+        curCell.setSize(origCellLabels.size());
+
+        forAll(origCellLabels, cellFacei)
+        {
+            curCell[cellFacei] = faceLookup_[origCellLabels[cellFacei]];
+        }
+    }
+
+    // Create processor mesh without a boundary
+
+
+    // create the mesh. Two situations:
+    // - points and faces come from the same time ('instance'). The mesh
+    //   will get constructed in the same instance.
+    // - points come from a different time (moving mesh cases).
+    //   It will read the points belonging to the faces instance and
+    //   construct the procMesh with it which then gets handled as above.
+    //   (so with 'old' geometry).
+    //   Only at writing time will it additionally write the current
+    //   points.
+
+    autoPtr<MeshType> procMeshPtr;
+
+    if (facesInstancePointsPtr_)
+    {
+        // Construct mesh from facesInstance.
+        pointField facesInstancePoints
+        (
+            facesInstancePointsPtr_(),
+            curPointLabels
+        );
+
+        procMeshPtr = autoPtr<MeshType>::New
+        (
+            IOobject
+            (
+                this->polyMesh::name(), // region of undecomposed mesh
+                facesInstance(),
+                processorDb,
+                IOobject::NO_READ,
+                IOobject::AUTO_WRITE
+            ),
+            std::move(facesInstancePoints),
+            std::move(procFaces),
+            std::move(procCells)
+        );
+    }
+    else
+    {
+        procMeshPtr = autoPtr<MeshType>::New
+        (
+            IOobject
+            (
+                this->polyMesh::name(), // region of undecomposed mesh
+                facesInstance(),
+                processorDb,
+                IOobject::NO_READ,
+                IOobject::AUTO_WRITE
+            ),
+            std::move(procPoints),
+            std::move(procFaces),
+            std::move(procCells)
+        );
+    }
+    MeshType& procMesh = procMeshPtr();
+
+
+    // Create processor boundary patches
+    const labelList& curPatchSizes = procPatchSize_[proci];
+
+    const labelList& curPatchStarts = procPatchStartIndex_[proci];
+
+    const labelList& curNeighbourProcessors =
+        procNeighbourProcessors_[proci];
+
+    const labelList& curProcessorPatchSizes =
+        procProcessorPatchSize_[proci];
+
+    const labelList& curProcessorPatchStarts =
+        procProcessorPatchStartIndex_[proci];
+
+    const labelListList& curSubPatchIDs =
+        procProcessorPatchSubPatchIDs_[proci];
+
+    const labelListList& curSubStarts =
+        procProcessorPatchSubPatchStarts_[proci];
+
+    const polyPatchList& meshPatches = boundaryMesh();
+
+
+    // Count the number of inter-proc patches
+    label nInterProcPatches = 0;
+    forAll(curSubPatchIDs, procPatchi)
+    {
+        nInterProcPatches += curSubPatchIDs[procPatchi].size();
+    }
+
+    polyPatchList procPatches
+    (
+        curPatchSizes.size() + nInterProcPatches
+    );
+
+    label nPatches = 0;
+
+    forAll(curPatchSizes, patchi)
+    {
+        // Get the face labels consistent with the field mapping
+        // (reuse the patch field mappers)
+        const polyPatch& meshPatch = meshPatches[patchi];
+
+        fvFieldDecomposer::patchFieldDecomposer patchMapper
+        (
+            SubList<label>
+            (
+                curFaceLabels,
+                curPatchSizes[patchi],
+                curPatchStarts[patchi]
+            ),
+            meshPatch.start()
+        );
+
+        // Map existing patches
+        procPatches.set
+        (
+            nPatches,
+            meshPatch.clone
+            (
+                procMesh.boundaryMesh(),
+                nPatches,
+                patchMapper.directAddressing(),
+                curPatchStarts[patchi]
+            )
+        );
+
+        nPatches++;
+    }
+
+    forAll(curProcessorPatchSizes, procPatchi)
+    {
+        const labelList& subPatchID = curSubPatchIDs[procPatchi];
+        const labelList& subStarts = curSubStarts[procPatchi];
+
+        label curStart = curProcessorPatchStarts[procPatchi];
+
+        forAll(subPatchID, i)
+        {
+            label size =
+            (
+                i < subPatchID.size()-1
+              ? subStarts[i+1] - subStarts[i]
+              : curProcessorPatchSizes[procPatchi] - subStarts[i]
+            );
+
+            if (subPatchID[i] == -1)
+            {
+                // From internal faces
+                procPatches.set
+                (
+                    nPatches,
+                    new processorPolyPatch
+                    (
+                        size,
+                        curStart,
+                        nPatches,
+                        procMesh.boundaryMesh(),
+                        proci,
+                        curNeighbourProcessors[procPatchi]
+                    )
+                );
+            }
+            else
+            {
+                const coupledPolyPatch& pcPatch
+                    = refCast<const coupledPolyPatch>
+                      (
+                          boundaryMesh()[subPatchID[i]]
+                      );
+
+                procPatches.set
+                (
+                    nPatches,
+                    new processorCyclicPolyPatch
+                    (
+                        size,
+                        curStart,
+                        nPatches,
+                        procMesh.boundaryMesh(),
+                        proci,
+                        curNeighbourProcessors[procPatchi],
+                        pcPatch.name(),
+                        pcPatch.transform()
+                    )
+                );
+            }
+
+            curStart += size;
+            ++nPatches;
+        }
+    }
+
+    // Add boundary patches
+    if constexpr (std::is_same_v<MeshType, fvMesh>)
+    {
+        procMesh.addFvPatches(procPatches);
+    }
+    else
+    {
+        procMesh.addPatches(procPatches);
+    }
+
+    // Create and add zones
+
+    // Point zones
+    {
+        const pointZoneMesh& pz = pointZones();
+
+        // Go through all the zoned points and find out if they
+        // belong to a zone.  If so, add it to the zone as
+        // necessary
+        List<DynamicList<label>> zonePoints(pz.size());
+
+        // Estimate size
+        forAll(zonePoints, zonei)
+        {
+            zonePoints[zonei].setCapacity(pz[zonei].size()/nProcs_);
+        }
+
+        // Use the pointToZone_ map to find out the single zone (if any),
+        // use slow search only for shared points.
+        forAll(curPointLabels, pointi)
+        {
+            label curPoint = curPointLabels[pointi];
+
+            label zonei = pointToZone_[curPoint];
+
+            if (zonei >= 0)
+            {
+                // Single zone.
+                zonePoints[zonei].append(pointi);
+            }
+            else if (zonei == -2)
+            {
+                // Multiple zones. Lookup.
+                forAll(pz, zonei)
+                {
+                    label index = pz[zonei].whichPoint(curPoint);
+
+                    if (index != -1)
+                    {
+                        zonePoints[zonei].append(pointi);
+                    }
+                }
+            }
+        }
+
+        procMesh.pointZones().clearAddressing();
+        procMesh.pointZones().setSize(zonePoints.size());
+        forAll(zonePoints, zonei)
+        {
+            procMesh.pointZones().set
+            (
+                zonei,
+                pz[zonei].clone
+                (
+                    procMesh.pointZones(),
+                    zonei,
+                    zonePoints[zonei].shrink()
+                )
+            );
+        }
+
+        if (pz.size())
+        {
+            // Force writing on all processors
+            procMesh.pointZones().writeOpt(IOobject::AUTO_WRITE);
+        }
+    }
+
+    // Face zones
+    {
+        const faceZoneMesh& fz = faceZones();
+
+        // Go through all the zoned face and find out if they
+        // belong to a zone.  If so, add it to the zone as
+        // necessary
+        List<DynamicList<label>> zoneFaces(fz.size());
+        List<DynamicList<bool>> zoneFaceFlips(fz.size());
+
+        // Estimate size
+        forAll(zoneFaces, zonei)
+        {
+            label procSize = fz[zonei].size() / nProcs_;
+
+            zoneFaces[zonei].setCapacity(procSize);
+            zoneFaceFlips[zonei].setCapacity(procSize);
+        }
+
+        // Go through all the zoned faces and find out if they
+        // belong to a zone.  If so, add it to the zone as
+        // necessary
+        forAll(curFaceLabels, facei)
+        {
+            // Remember to decrement the index by one (turning index)
+            //
+            label curF = mag(curFaceLabels[facei]) - 1;
+
+            label zonei = faceToZone_[curF];
+
+            if (zonei >= 0)
+            {
+                // Single zone. Add the face
+                zoneFaces[zonei].append(facei);
+
+                label index = fz[zonei].whichFace(curF);
+
+                bool flip = fz[zonei].flipMap()[index];
+
+                if (curFaceLabels[facei] < 0)
+                {
+                    flip = !flip;
+                }
+
+                zoneFaceFlips[zonei].append(flip);
+            }
+            else if (zonei == -2)
+            {
+                // Multiple zones. Lookup.
+                forAll(fz, zonei)
+                {
+                    label index = fz[zonei].whichFace(curF);
+
+                    if (index != -1)
+                    {
+                        zoneFaces[zonei].append(facei);
+
+                        bool flip = fz[zonei].flipMap()[index];
+
+                        if (curFaceLabels[facei] < 0)
+                        {
+                            flip = !flip;
+                        }
+
+                        zoneFaceFlips[zonei].append(flip);
+                    }
+                }
+            }
+        }
+
+        procMesh.faceZones().clearAddressing();
+        procMesh.faceZones().setSize(zoneFaces.size());
+        forAll(zoneFaces, zonei)
+        {
+            procMesh.faceZones().set
+            (
+                zonei,
+                fz[zonei].clone
+                (
+                    zoneFaces[zonei].shrink(),          // addressing
+                    zoneFaceFlips[zonei].shrink(),      // flipmap
+                    zonei,
+                    procMesh.faceZones()
+                )
+            );
+        }
+
+        if (fz.size())
+        {
+            // Force writing on all processors
+            procMesh.faceZones().writeOpt(IOobject::AUTO_WRITE);
+        }
+    }
+
+    // Cell zones
+    {
+        const cellZoneMesh& cz = cellZones();
+
+        // Go through all the zoned cells and find out if they
+        // belong to a zone.  If so, add it to the zone as
+        // necessary
+        List<DynamicList<label>> zoneCells(cz.size());
+
+        // Estimate size
+        forAll(zoneCells, zonei)
+        {
+            zoneCells[zonei].setCapacity(cz[zonei].size()/nProcs_);
+        }
+
+        forAll(curCellLabels, celli)
+        {
+            label curCelli = curCellLabels[celli];
+
+            label zonei = cellToZone_[curCelli];
+
+            if (zonei >= 0)
+            {
+                // Single zone.
+                zoneCells[zonei].append(celli);
+            }
+            else if (zonei == -2)
+            {
+                // Multiple zones. Lookup.
+                forAll(cz, zonei)
+                {
+                    label index = cz[zonei].whichCell(curCelli);
+
+                    if (index != -1)
+                    {
+                        zoneCells[zonei].append(celli);
+                    }
+                }
+            }
+        }
+
+        procMesh.cellZones().clearAddressing();
+        procMesh.cellZones().setSize(zoneCells.size());
+        forAll(zoneCells, zonei)
+        {
+            procMesh.cellZones().set
+            (
+                zonei,
+                cz[zonei].clone
+                (
+                    zoneCells[zonei].shrink(),
+                    zonei,
+                    procMesh.cellZones()
+                )
+            );
+        }
+
+        if (cz.size())
+        {
+            // Force writing on all processors
+            procMesh.cellZones().writeOpt(IOobject::AUTO_WRITE);
+        }
+    }
+
+    return procMeshPtr;
+}
